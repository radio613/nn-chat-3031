doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")
    link(rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      integrity="sha256-fx038NkLY4U1TCrBDiu5FWPEa9eiZu01EiLryshJbCo="
      crossorigin="anonymous")
    link(rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.0/font/bootstrap-icons.css")
    link(rel="stylesheet" href="style.css")
    title NNチャット
  body(data-bs-theme=currentTheme)
    
    //- ヘッダーナビゲーション
    nav.navbar.fixed-top.bg-primary.navbar-dark.shadow-sm
      div.container
        h1.text-light.navbar-brand.mb-0.fw-bold NNチャット
          i.bi-chat-dots-fill.ms-2
        div.dropdown
          button.btn.btn-outline-light.dropdown-toggle.btn-sm(type="button" id="menu" data-bs-toggle="dropdown" aria-expanded="false") #{user}
            i.bi-gear-fill.ms-1
          ul.dropdown-menu.dropdown-menu-end(aria-labelledby="menu")
            li
              - const changeThemeText = (currentTheme === 'light' ? 'ダークモードにする' : 'ライトモードにする');
              a.dropdown-item(href="/changeTheme") #{changeThemeText}
            li
              a.dropdown-item.text-danger(href="/logout") ログアウト

    //- メインタイムライン（上下に固定バーを避けるためのマージンを確保）
    main.container.my-5.py-5(style="max-width: 800px;")
      each post in posts
        - const isMe = (user === post.postedBy)
        //- 自分の投稿は右寄せ(ms-auto)、他人の投稿は左寄せ(me-auto)
        - const cardClass = isMe ? 'card my-3 border-primary shadow-sm ms-auto chat-bubble-me' : 'card my-3 shadow-sm me-auto chat-bubble-other'
        
        div(class=cardClass style="max-width: 75%; min-width: 280px;")
          div.card-body.p-3
            div.d-flex.justify-content-between.align-items-center.mb-2
              div.d-flex.align-items-center
                //- 自分の名前は青、管理者は赤など色分けすると見やすいです
                h6.card-title.mb-0.fw-bold(class=isMe ? 'text-primary' : '') #{post.postedBy}
                  if post.postedBy === 'admin'
                    i.bi-patch-check-fill.ms-1.text-danger
              
              //- 時間表示
              - const tooltipTitle = `<small>${post.absoluteCreatedAt}</small>`
              small.text-muted(data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true" title=tooltipTitle style="font-size: 0.75rem;") #{post.relativeCreatedAt}
            
            //- 投稿本文
            p.card-text.mb-0(style="white-space: pre-wrap;") #{post.content}
            
            //- 削除ボタンを右下にそっと配置（フッターを廃止してスッキリ）
            - const isDeletable = (user === post.postedBy || user === 'admin')
            if isDeletable
              div.text-end.mt-1
                form(method="post" action="/posts/delete" style="display: inline;")
                  input(type="hidden" name="id" value=post.id)
                  input(type="hidden" name="oneTimeToken" value=oneTimeToken)
                  button(type="submit" title="削除").btn.text-danger.p-0.border-0(style="font-size: 0.85rem;")
                    i.bi-trash.me-1
                    span 削除

    //- 固定送信フォーム（上部に境界線とシャドウをつけて浮き上がらせる）
    div.fixed-bottom.bg-body.border-top.shadow-lg.p-3
      div.container(style="max-width: 800px;")
        form(method="post" action="/posts" name="message-form").row.g-2
          div.col
            textarea(name="content" rows="2" placeholder="メッセージを入力... (Ctrl+Enterで送信)").form-control
            input(type="hidden" name="oneTimeToken" value=oneTimeToken)
          div.col-auto.d-flex.align-items-end
            button(type="submit").btn.btn-primary.h-100.px-3
              i.bi-send.fs-5

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
      integrity="sha256-qlPVgvl+tZTCpcxYJFdHB/m6mDe84wRr+l81VoYPTgQ="
      crossorigin="anonymous")
    script(src="nn-chat.js")